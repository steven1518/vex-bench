# Claude Code CLI via Azure AI Foundry.
# Passed to the container with `docker run --env-file`.
#
# Docs: https://code.claude.com/docs/en/microsoft-foundry
#       https://learn.microsoft.com/en-us/azure/foundry/foundry-models/how-to/configure-claude-code
#
# To fill in: ANTHROPIC_FOUNDRY_RESOURCE and ANTHROPIC_FOUNDRY_API_KEY.
# Find both in the Microsoft Foundry portal (https://ai.azure.com/) — the
# resource name is your project's "Parent resource"; the API key is on the
# project home page as "Project API key".

CLAUDE_CODE_USE_FOUNDRY=1
IS_SANDBOX=1
# Foundry resource name; the CLI expands this to
#   https://<resource>.services.ai.azure.com/anthropic
# (Alternative: set ANTHROPIC_FOUNDRY_BASE_URL to override the full URL.)
ANTHROPIC_FOUNDRY_RESOURCE=<your-foundry-resource-name>

# API key authentication. Entra ID / az-login isn't usable in our
# disposable containers, so this is the only practical option.
ANTHROPIC_FOUNDRY_API_KEY=<your-foundry-api-key>

# Model deployment names — must match the deployments created in Foundry.
# Pin a specific version: bare aliases (sonnet/opus/haiku) can break when
# Anthropic ships a new model that hasn't been deployed in your account.
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6
